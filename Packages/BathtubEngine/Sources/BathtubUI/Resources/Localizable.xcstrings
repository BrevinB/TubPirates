    "Use this shot to 'see' all of the ships in a certain area. Causes no damage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem Schuss siehst du alle Schiffe in einem Bereich. Verursacht keinen Schaden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this shot to 'see' all of the ships in a certain area. Causes no damage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa este disparo para “ver” todos los barcos en una zona. No causa daño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez ce tir pour « voir » tous les navires dans une zone. Ne cause aucun dégât."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定範囲にあるすべての船を「見る」ショット。ダメージはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use este tiro para “ver” todos os navios em uma área. Não causa dano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用这一炮“查看”某片区域内的所有船只。不造成伤害。"
