    "Nine lives, zero mercy. She fights dirty for someone so clean." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neun Leben, null Gnade. Für jemanden so Sauberes kämpft sie ziemlich schmutzig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nine lives, zero mercy. She fights dirty for someone so clean."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueve vidas, cero piedad. Pelea sucio para alguien tan limpio."
