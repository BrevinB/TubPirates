    "Doubloons are spent on special cannons, avatars, and fleets. Purchases add to your balance instantly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dublonen werden für Spezialkanonen, Avatare und Flotten ausgegeben. Käufe werden sofort deinem Guthaben hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubloons are spent on special cannons, avatars, and fleets. Purchases add to your balance instantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los doblones se gastan en cañones especiales, avatares y flotas. Las compras se añaden al instante a tu saldo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les doublons servent aux canons spéciaux, avatars et flottes. Les achats sont ajoutés instantanément à votre solde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブロンは特殊砲、アバター、艦隊に使えます。購入分はすぐ残高に追加されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrões são gastos em canhões especiais, avatares e frotas. Compras são adicionadas ao saldo instantaneamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
